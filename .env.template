## Xibo CMS Configuration
##
## Make a copy of this file called .env (in the same folder as
## docker-compose.yml), then edit it to suit your environment.
##
## Docker Compose reads .env both to configure the containers and to fill in
## the port numbers and profiles used by docker-compose.yml.

## The Docker Compose project name (default "xibo"). Only change this to run
## more than one CMS on the same host, giving each installation its own name
## and its own CMS_WEB_PORT / CMS_XMR_PORT.
# COMPOSE_PROJECT_NAME=xibo

## ---------------------------------------------------------------------------
## Database
## ---------------------------------------------------------------------------

## By default the CMS brings its own MySQL server (the "local-db" profile).
## To use your own remote MySQL server instead, delete or comment out the
## line below and complete the "Remote MySQL" section further down.
COMPOSE_PROFILES=local-db

## On a new installation we create a user account for the CMS to connect to
## the database with. What password should that account use? Enter a random
## password here, we recommend 16 random upper/lower case letters and digits.
##
## IMPORTANT: DO NOT USE SPECIAL CHARACTERS, SPACES etc. Please use only
## alpha-numeric (ie A-Z a-z 0-9) characters.
##
## If you're upgrading an existing installation, be sure to use the existing
## password for the cms user account (ie what you had here previously).
MYSQL_PASSWORD=

## Remote MySQL
## Only needed if you removed COMPOSE_PROFILES=local-db above. The database
## must already exist (and be empty for a new installation) and the user
## must have all privileges on it. MYSQL_PASSWORD above is used for this user.
## With the bundled MySQL, leave MYSQL_HOST and MYSQL_PORT unset, and leave
## MYSQL_DATABASE and MYSQL_USER unset unless you're starting a brand new
## installation (the bundled MySQL only creates them on its first start).
# MYSQL_HOST=mysql.example.org
# MYSQL_PORT=3306
# MYSQL_DATABASE=cms
# MYSQL_USER=cms

## To connect to MySQL over TLS/SSL, set MYSQL_ATTR_SSL_CA to the path
## inside the web container of the CA certificate that signed your MySQL
## server's certificate. We recommend putting it in shared/cms/custom.
# MYSQL_ATTR_SSL_CA=/var/www/cms/custom/ca.pem
## Verify that the MySQL server's hostname matches its certificate.
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

## ---------------------------------------------------------------------------
## Ports
## ---------------------------------------------------------------------------

## The host ports the CMS web interface and XMR (push messaging for Players)
## listen on. Change these if something else on this host already uses them.
# CMS_WEB_PORT=80
# CMS_XMR_PORT=9505

## ---------------------------------------------------------------------------
## Email (SMTP)
## ---------------------------------------------------------------------------

## The CMS needs to be able to send email to you. Enter the details of a
## suitable SMTP server. The defaults below suit Gmail: use your Gmail address
## as the username and an App Password (not your normal account password).
## See https://support.google.com/accounts/answer/185833

## SMTP server hostname and port
CMS_SMTP_SERVER=smtp.gmail.com:587
## SMTP username
CMS_SMTP_USERNAME=youraccount@gmail.com
## SMTP password
CMS_SMTP_PASSWORD=yourpassword
## Use a TLS connection YES/NO
CMS_SMTP_USE_TLS=YES
## Use a STARTTLS connection YES/NO
CMS_SMTP_USE_STARTTLS=YES
## Rewrite domain (the domain your email will appear to come from)
CMS_SMTP_REWRITE_DOMAIN=gmail.com
## Hostname that we should identify ourselves to the remote server as
CMS_SMTP_HOSTNAME=gmail.com
## Can the From line be overridden in the outbound email - YES/NO
## Gmail rewrites the From address anyway, so this doesn't matter for Gmail.
CMS_SMTP_FROM_LINE_OVERRIDE=YES
## Fix the from email address if your SMTP relay relies on a specific value
# CMS_SMTP_FROM=myemail@example.org

## ---------------------------------------------------------------------------
## Web server
## ---------------------------------------------------------------------------

## The DNS name you will normally use to reach the CMS. For most
## installations this is unnecessary, but it won't hurt to set it.
# CMS_SERVER_NAME=cms.example.org

## Run the CMS in a sub directory of the web server rather than at the root.
## Leave commented out to use the web root.
# CMS_ALIAS=/xibo

## Individual file uploads are limited to 2GB. If you need larger files,
## uncomment the following and adjust as required.
# CMS_PHP_POST_MAX_SIZE=4G
# CMS_PHP_UPLOAD_MAX_FILESIZE=4G
# CMS_PHP_MAX_EXECUTION_TIME=600

## ---------------------------------------------------------------------------
## Optional services
## ---------------------------------------------------------------------------

## The CMS can email reports and charts, which needs a charting service.
## A QuickChart container is included in docker-compose.yml. Change this only
## if you want to use a QuickChart service you provide yourself.
# CMS_QUICK_CHART_URL=http://cms-quickchart:3400

## The CMS has a CRON based task runner built into the web container. Set
## this to false if you run the task runner externally instead.
# XTR_ENABLED=false

## Memcached caches resources downloaded from third parties, display
## schedules, required files, etc. and locks resources while they update.
## Set this to false to use a file cache in the library/cache folder instead.
# CMS_USE_MEMCACHED=false
## Use an external or alternative memcached server.
# MEMCACHED_HOST=cms-memcached
# MEMCACHED_PORT=11211

## ---------------------------------------------------------------------------
## Anonymous usage reporting
## ---------------------------------------------------------------------------

## Once per week the CMS sends an anonymous usage report to a server owned
## by Xibo Signage Ltd: CMS version, install type (docker/custom), the
## number of approved players and the number of each player type. A random
## 32 character key is generated the first time a report is sent and cannot
## be traced back to your environment. We use this data to decide where best
## to focus our efforts. Uncomment the line below to turn it off.
# CMS_USAGE_REPORT=false
