{% extends "non-authed.twig" %}

{% block title %}{{ "About"|trans }} | {% endblock %}

{% block style %}
<style type="text/css">
    .about-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 20px 15px;
    }
    .about-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }
    .login-logo {
        height: 40px;
        width: auto;
    }
    .about-container {
        padding: 24px 28px;
        background-color: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 5px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }
    .about-footer {
        margin-top: 14px;
        font-size: 12px;
        color: #888;
        text-align: center;
    }
    .about-footer .badge {
        font-size: 11px;
    }
</style>
{% endblock %}

{% block header %}{% endblock %}
{% block contentClass %}{% endblock %}

{% block content %}
    <div class="about-wrap">
        <div class="about-header">
            <a href="{{ theme.getThemeConfig("theme_url") }}"><img class="login-logo" src="{{ logoUrl }}" alt="Logo"></a>
            <a class="btn btn-info btn-sm" href="{{ url_for("home") }}">{% trans "Home" %}</a>
        </div>
        <div class="about-container">
            {% include "licence.twig" %}
        </div>
        <p class="about-footer">
            {% trans "Version" %} {{ version }}{% if revision %} &nbsp;<span class="badge badge-info">SHA: {{ revision }}</span>{% endif %}
        </p>
    </div>
{% endblock %}
