{% extends "authed.twig" %}
{% import "inline.twig" as inline %}

{% block title %}{{ "Playlist Editor"|trans }} | {% endblock %}

{% set hideNavigation = "1" %}
{% set forceHide = true %}

{% block pageContent %}

    <div id="editor-container">
        <div class="modal editor-modal">
            <div class="modal-dialog editor-modal-dialog">
                <div class="modal-content editor-modal-content">

                    <div class="modal-header editor-modal-header">
                        <div class="modal-header--left"></div>
                        <div class="d-flex align-items-center">
                            <span class="editor-modal-help-slot d-none"></span>
                            <button type="button" class="close editor-modal-close pl-2">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <div class="modal-body editor-modal-body container-designer">
                        <div class="editor-top-bar"></div>
                        <div id="playlist-editor" playlist-id="{{ playlist.playlistId }}"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="loading-overlay">
        <i class="fa fa-spinner fa-spin loading-icon"></i>
    </div>

{% endblock %}

    {% block javaScript %}
        {% include "editorTranslations.twig" %}
        {% include "editorVars.twig" %}

        <script src="{{ theme.rootUri() }}dist/playlistEditor.bundle.min.js?v={{ version }}&rev={{revision}}" nonce="{{ cspNonce }}"></script>
        <script src="{{ theme.rootUri() }}dist/codeEditor.bundle.min.js?v={{ version }}&rev={{revision}}" nonce="{{ cspNonce }}"></script>
        <script src="{{ theme.rootUri() }}dist/wysiwygEditor.bundle.min.js?v={{ version }}&rev={{revision}}" nonce="{{ cspNonce }}"></script>
        <script src="{{ theme.rootUri() }}dist/editorCommon.bundle.min.js?v={{ version }}&rev={{revision}}" nonce="{{ cspNonce }}"></script>
        <script type="text/javascript" nonce="{{ cspNonce }}">
            $(document).ready(function() {
                pE.loadEditor();

                // The host page shows its help menu button over this slot
                if (window.parent !== window) {
                    const $helpSlot = $('.editor-modal-help-slot').removeClass('d-none');
                    const postHelpSlot = function() {
                        const rect = $helpSlot[0].getBoundingClientRect();
                        window.parent.postMessage(
                            {type: 'xibo:editor-help-slot', top: rect.top, left: rect.left},
                            window.location.origin
                        );
                    };
                    new ResizeObserver(postHelpSlot).observe($('.editor-modal-header')[0]);
                }

                const _originalClose = pE.close.bind(pE);
                pE.close = function() {
                    _originalClose();
                    if (window.parent !== window) {
                        window.parent.postMessage(
                            {type: 'xibo:editor-exit'},
                            window.location.origin
                        );
                    } else {
                        window.close();
                    }
                };
            });
        </script>
    {% endblock %}
