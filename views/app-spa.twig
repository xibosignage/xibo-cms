<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Copyright 2006-{{ 'now' | date('Y') }} Xibo Signage Ltd. Part of the Xibo Open Source Digital Signage Solution. Released under the AGPLv3 or later. -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ theme.getThemeConfig("theme_title", "Xibo Digital Signage") }}</title>

    {# CSRF token. Not read from this meta tag by the main app (which uses the XSRF-TOKEN cookie
       via CsrfGuard instead — see AuthorizeApplication.tsx for the one place that reads the
       cookie directly); kept for markup parity with the login shell, which does read its own
       copy of this tag. Now a real, non-blank value since this render runs through CsrfGuard. #}
    <meta name="token" content="{{ csrfToken }}"/>
    {# Install root (e.g. '/' or '/cms/'). React Router derives its basename from this in production. #}
    <meta name="public-path" content="{{ theme.rootUri() }}"/>

    {# Base where built assets + public files (locales) are served. The SPA resolves code-split
       chunks and locale files against this at runtime, so sub-folder/alias installs work.
       Runs before the module scripts below (classic inline script executes at parse time). #}
    <script nonce="{{ cspNonce }}">window.__XIBO_ASSET_BASE__ = "{{ assetBase }}";</script>

    {# Whether this instance is in the 'partial' suspension state (displays serve cached
       content only, but the CMS itself stays fully usable). Read from the 'settings' global
       that Xibo\Middleware\Theme already exposes to every Twig render — the same source
       legacy authed.twig reads settings.INSTANCE_SUSPENDED from — so no controller change
       is needed here. RootLayout.tsx reads this to show a warning banner. #}
    <script nonce="{{ cspNonce }}">window.__XIBO_APP_CONFIG__ = { partiallySuspended: {{ settings.INSTANCE_SUSPENDED == "partial" ? 'true' : 'false' }} };</script>

    <link rel="shortcut icon" href="{{ brand.assetUrl('favicon') }}"/>
    {% if brand.stylesheetUrl %}<link rel="stylesheet" href="{{ brand.stylesheetUrl }}">{% endif %}

    {% for cssUrl in appCssUrls %}
        <link rel="stylesheet" href="{{ cssUrl }}">
    {% endfor %}
    {# After the app CSS, which sets Xibo's default colours. #}
    {% if brand.tokens %}<style>:root { {% for name, value in brand.tokens %}--{{ name }}: {{ value }}; {% endfor %}}</style>{% endif %}
</head>
<body>
    <div id="root"></div>

    {% if viteRefreshUrl %}
        {#
            React Fast Refresh preamble — must execute before any React module.
            @vitejs/plugin-react transforms every component to call $RefreshReg$/$RefreshSig$
            and throws if __vite_plugin_react_preamble_installed__ is not set.
            Vite injects this automatically when it serves the HTML; since PHP serves this
            shell we have to do it manually.
        #}
        <script type="module" nonce="{{ cspNonce }}">
            import RefreshRuntime from "{{ viteRefreshUrl }}"
            RefreshRuntime.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => {}
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
        </script>
    {% endif %}
    {% if viteClientUrl %}
        <script type="module" src="{{ viteClientUrl }}" nonce="{{ cspNonce }}"></script>
    {% endif %}
    <script type="module" src="{{ appJsUrl }}" nonce="{{ cspNonce }}"></script>
</body>
</html>
