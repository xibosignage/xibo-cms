<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ theme.getThemeConfig("theme_title", "Xibo Digital Signage") }}</title>

    {# CSRF token — kept for parity with the login shell; harmless if unused by the app. #}
    <meta name="token" content="{{ csrfToken }}"/>
    {# Install root (e.g. '/' or '/cms/'). React Router derives its basename from this in production. #}
    <meta name="public-path" content="{{ theme.rootUri() }}"/>

    {# Base where built assets + public files (locales) are served. The SPA resolves code-split
       chunks and locale files against this at runtime, so sub-folder/alias installs work.
       Runs before the module scripts below (classic inline script executes at parse time). #}
    <script nonce="{{ cspNonce }}">window.__XIBO_ASSET_BASE__ = "{{ assetBase }}";</script>

    <link rel="shortcut icon" href="{{ theme.rootUri() }}brand/favicon.ico"/>
    <link rel="stylesheet" href="{{ theme.rootUri() }}brand/theme.css">

    {% if appCssUrl %}
        <link rel="stylesheet" href="{{ appCssUrl }}">
    {% endif %}
</head>
<body>
    <div id="root"></div>

    {% if viteRefreshUrl %}
        {#
            React Fast Refresh preamble — must execute before any React module.
            @vitejs/plugin-react transforms every component to call $RefreshReg$/$RefreshSig$
            and throws if __vite_plugin_react_preamble_installed__ is not set.
            Vite injects this automatically when it serves the HTML; since PHP serves this
            shell we have to do it manually.
        #}
        <script type="module" nonce="{{ cspNonce }}">
            import RefreshRuntime from "{{ viteRefreshUrl }}"
            RefreshRuntime.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => {}
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
        </script>
    {% endif %}
    {% if viteClientUrl %}
        <script type="module" src="{{ viteClientUrl }}" nonce="{{ cspNonce }}"></script>
    {% endif %}
    <script type="module" src="{{ appJsUrl }}" nonce="{{ cspNonce }}"></script>
</body>
</html>
